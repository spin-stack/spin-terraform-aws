# Copy this to terraform.tfvars and fill it in. Keeping the values here rather than on the command
# line is what makes an update one edit, and nothing else changes by accident.

# The release: a channel - stable, a release a person promoted, or edge, every release once its
# images are checked - which the next plan follows, or a release of
# https://github.com/spin-stack/spin/releases, v<YYYYMMDD>.<N>, which only an edit here moves.
spin_version = "stable"

# The domain the installation answers on: the dashboard is app.<domain>. Its zone is made here;
# point the domain's registrar at the name servers `tofu output name_servers` prints.
domain = "example.com"

# The region, if not us-west-2. It must be the one bootstrap/ was applied in.
# region = "us-west-2"
