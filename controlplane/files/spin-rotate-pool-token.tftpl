#!/bin/bash
# Mint a pool's registration token and publish it where the runners' group reads it. A file,
# not an argument: a token on a command line is in ps.
set -euo pipefail
file=$(mktemp); trap 'rm -f "$file"' EXIT; chmod 600 "$file"
# An assignment, so a mint that fails stops here rather than publishing an empty token.
token=$(spin-controlplane registration-token --reusable \
  --expires '${token_expiry}' --description '${name} runners, rotated' ${pool_flags})
[ -n "$token" ] || { echo "the control plane minted an empty token"; exit 1; }
printf '%s' "$token" >"$file"
/snap/bin/aws --region '${region}' ssm put-parameter --name '${token_parameter}' --type SecureString \
  --overwrite --value "file://$file" >/dev/null
