#!/bin/bash
# A control plane down three minutes running is a machine for the group to replace: one an
# update superseded, which stays down on purpose, or one whose update failed after it took the
# term, which would otherwise hold the installation's name with nothing behind it. A stop by
# hand is the same, so an operator who wants the machine kept stops this timer first.
set -euo pipefail
. /usr/local/lib/spin/lifecycle.sh
count=/run/spin-controlplane-down
if systemctl is-active --quiet spin-controlplane.service; then
  rm -f "$count"
  exit 0
fi
n=$(($(cat "$count" 2>/dev/null || echo 0) + 1))
echo "$n" >"$count"
if [ "$n" -ge 3 ]; then
  echo "the control plane has been down for $n minutes: asking the group to replace this machine"
  unhealthy
fi
