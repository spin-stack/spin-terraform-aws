# Pinned tools, installed by `task tools:tofu`, and each directory's provider cache.
.tools/
**/.terraform/
# An installation's own values, which are the operator's (terraform.tfvars.example is the form).
terraform.tfvars
# bootstrap/'s own state, which is the account's and nobody else's.
*.tfstate
*.tfstate.backup
# What tofu keeps when it moves a state, named by the time it did.
*.tfstate.*.backup
# bootstrap/'s values, the operator's as terraform.tfvars is.
bootstrap/*.auto.tfvars
