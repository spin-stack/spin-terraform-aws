#!/bin/bash
# A proxy machine's first boot: its tarball, checked and unpacked; the CA the control plane
# publishes; the certificates the last proxy had; spin-install proxy; and then the installation
# moved to it - its name, the elastic IP, and the group told it is in service.
set -euo pipefail
exec > >(tee -a /var/log/spin-bootstrap.log) 2>&1

export PATH="/snap/bin:$PATH"
snap install aws-cli --classic

# --- this machine's files (files/, proxy.tf) -------------------------------------------------
${write_files}
. /usr/local/lib/spin/lifecycle.sh

${fetch_release}
cd "$(mktemp -d)"
release '${spin_version}' spin-proxy-linux-amd64.tar.gz
tar -xzf spin-proxy-linux-amd64.tar.gz -C /

# The control plane's first start publishes it, and is serving by then.
ca=''
for _ in $(seq 180); do
  ca=$(aws --region '${region}' ssm get-parameter --name '${ca_parameter}' --query Parameter.Value --output text) || ca=''
  [ -n "$ca" ] && [ "$ca" != '${unpublished}' ] && break
  sleep 10
done
if [ -z "$ca" ] || [ "$ca" = '${unpublished}' ]; then
  echo "the control plane published no CA in half an hour"
  exit 1
fi
install -d -m 0755 /etc/spin-bootstrap
printf '%s\n' "$ca" >/etc/spin-bootstrap/ca.crt

# Before Caddy first starts: the names it serves are the ones the last proxy had certificates
# for. As Caddy's user, which is made here as spin-install would make it — it finds it there
# and keeps it — so nothing the bucket holds is written with root's rights.
useradd --system --user-group --no-create-home --home-dir /var/lib/spin-proxy --shell /usr/sbin/nologin spin-proxy
install -d -o spin-proxy -g spin-proxy -m 0700 /var/lib/spin-proxy
runuser -u spin-proxy -- /usr/local/sbin/spin-proxy-certificates restore

spin-install proxy --control-plane '${controlplane}' --ca /etc/spin-bootstrap/ca.crt \
  --domain '${domain}' %{ if acme_email != "" }--acme-email '${acme_email}'%{ endif } \
  %{ if collector != "" }--otel-collector '${collector}' --otel-metric-interval '${metric_interval}'%{ endif }

# Caddy answers here before anything is moved to it.
for _ in $(seq 60); do
  curl -fsS -o /dev/null http://127.0.0.1:8081/health && break
  sleep 2
done
curl -fsS -o /dev/null http://127.0.0.1:8081/health

# Then the installation: the runners' relay by its name, the internet by its address. The old
# proxy's connections end here, and each client reconnects to this one.
point '${proxy_host}'
aws --region '${region}' ec2 associate-address --allocation-id '${allocation_id}' \
  --instance-id "$(imds instance-id)" --allow-reassociation >/dev/null
systemctl daemon-reload
systemctl enable --now spin-proxy-certificates.timer
in_service
echo "spin proxy is installed and in service"
