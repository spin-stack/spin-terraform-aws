#!/bin/bash
# spin-proxy-certificates restore|save: Caddy's certificates and ACME account, between this
# machine and the bucket every proxy of the installation keeps them in. Restored before Caddy
# first starts, so a replacement serves the names the last one had without asking Let's Encrypt
# again - fifty certificates a week is the whole allowance - and saved every few minutes, so what
# was issued since is there for the next.
#
# Run as Caddy's own user and never as root: the directory is Caddy's, and whatever Caddy put in
# it - a link to /etc/shadow, say - is read with Caddy's rights and no more. Links are not
# followed either way.
set -euo pipefail
if [ "$(id -u)" -eq 0 ]; then
  echo "$0 runs as spin-proxy: as root it would read whatever the directory it copies links to" >&2
  exit 1
fi
export HOME=/var/lib/spin-proxy
here=/var/lib/spin-proxy/data/caddy
there='s3://${bucket}/caddy'
case "$1" in
  restore)
    mkdir -p "$here"
    /snap/bin/aws --region '${region}' s3 sync --only-show-errors "$there" "$here"
    ;;
  save) /snap/bin/aws --region '${region}' s3 sync --only-show-errors --no-follow-symlinks --exclude 'locks/*' "$here" "$there" ;;
  *) echo "usage: $0 restore|save" >&2; exit 2 ;;
esac
