[Unit]
Description=Save Caddy's certificates to the installation's bucket for them
After=spin-proxy.service

[Service]
Type=oneshot
# Caddy's user, reading Caddy's directory: never root, which would read whatever Caddy links it to.
User=spin-proxy
Group=spin-proxy
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/spin-proxy
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/local/sbin/spin-proxy-certificates save
