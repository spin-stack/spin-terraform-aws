# What a machine of an autoscaling group of one says about itself, sourced by its first boot and
# by its timers: an update stands the new machine beside the old, and these are how the new one
# takes the installation over - its name, then the group's word that it is in service.

# imds <path>: this machine's own metadata, over IMDSv2.
imds() {
  local token
  token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
  curl -fsS -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

# point <name> [address]: the internal zone's <name> at address — this machine, by default —
# from now on.
point() {
  local change
  change=$(printf '{"Changes":[{"Action":"UPSERT","ResourceRecordSet":{"Name":"%s","Type":"A","TTL":%d,"ResourceRecords":[{"Value":"%s"}]}}]}' \
    "$1" '${ttl}' "$${2:-$(imds local-ipv4)}")
  /snap/bin/aws route53 change-resource-record-sets --hosted-zone-id '${zone_id}' --change-batch "$change" >/dev/null
}

# resolve <name>: the address <name> points at now, or nothing — and success either way: on the
# installation's first machine the name does not exist yet, and getent's "not found" is an exit
# status that set -e and pipefail would take for a failure of the boot.
resolve() {
  { getent ahostsv4 "$1" || true; } | awk 'NR == 1 { print $1 }'
}

# heartbeating: says, every ${heartbeat}s for as long as the boot that started it runs, that the
# launch is still going. With it the hook's timeout is how long a machine may go silent rather
# than how long a first boot may take, so a machine that dies - or one somebody terminated - is
# abandoned in minutes instead of holding the group for half an hour, while a slow boot gets all
# the time it needs. The loop watches the boot's own process, so nothing has to stop it.
heartbeating() {
  local boot=$$
  (
    while kill -0 "$boot" 2>/dev/null; do
      /snap/bin/aws --region '${region}' autoscaling record-lifecycle-action-heartbeat \
        --auto-scaling-group-name '${group}' --lifecycle-hook-name ready \
        --instance-id "$(imds instance-id)" || true
      sleep ${heartbeat}
    done
  ) >/dev/null 2>&1 &
}

# in_service: the launch is complete, and the group may retire the machine this one replaces.
# Until it is said, the group waits; if it is never said, the group abandons this machine and
# the old one goes on serving.
in_service() {
  /snap/bin/aws --region '${region}' autoscaling complete-lifecycle-action --auto-scaling-group-name '${group}' \
    --lifecycle-hook-name ready --lifecycle-action-result CONTINUE --instance-id "$(imds instance-id)"
}

# abandon: the launch failed, and the group is to discard this machine now rather than when
# the hook times out.
abandon() {
  /snap/bin/aws --region '${region}' autoscaling complete-lifecycle-action --auto-scaling-group-name '${group}' \
    --lifecycle-hook-name ready --lifecycle-action-result ABANDON --instance-id "$(imds instance-id)"
}

# unhealthy: the group is to replace this machine.
unhealthy() {
  /snap/bin/aws --region '${region}' autoscaling set-instance-health --instance-id "$(imds instance-id)" \
    --health-status Unhealthy
}
