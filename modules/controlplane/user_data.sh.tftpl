#!/bin/bash
# A control plane machine's first boot: the release's tarball, checked and unpacked; the role it
# signs in to the catalog as; its name, then spin-install, which takes the term; what runners
# join with, published; and the group told it is in service. Everything here drives
# spin-install, systemd and the AWS CLI; what spin does is spin-install's. Nothing on this
# machine is kept across a replacement: the catalog is RDS, and the key that opens what it
# seals is in SSM.
set -euo pipefail
exec > >(tee -a /var/log/spin-bootstrap.log) 2>&1

export PATH="/snap/bin:$PATH"
region='${region}'
aws() { command aws --region "$region" "$@"; }

# --- what the machine needs ------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -yq postgresql-client
snap install aws-cli --classic
%{ if collector != "" ~}
# The collector's package, checked against the SHA-256 the module pins before it is installed.
deb='alloy-${alloy_version}-1.amd64.deb'
curl -fsSL -o "/tmp/$deb" "https://github.com/grafana/alloy/releases/download/v${alloy_version}/$deb"
printf '%s  %s\n' '${alloy_sha256}' "/tmp/$deb" | sha256sum --check --quiet
apt-get install -yq "/tmp/$deb"
%{ endif ~}

# --- this machine's files (files/, machine_files.tf) -----------------------------------------
${write_files}

# Until this machine is in service, a boot that stops hands the installation back and abandons
# the launch now rather than when the hook times out. Before the takeover there is nothing to
# hand back; from it on, the control plane is stopped and the name pointed where it was, and the
# old machine's watchdog, seeing its own name and no control plane, starts it and it takes the
# term again.
. /usr/local/lib/spin/lifecycle.sh
heartbeating
previous=
serving=
hand_back() {
  [ -z "$serving" ] || return 0
  echo "this machine did not come into service: handing the installation back"
  systemctl stop spin-controlplane.service || true
  if [ -n "$previous" ] && [ "$previous" != "$(imds local-ipv4)" ]; then
    point '${cp_host}' "$previous" || true
  fi
  abandon || true
}
trap hand_back EXIT

# --- the encryption key: SSM's, and nowhere else -----------------------------------------------
# Everything the catalog seals is sealed under it, so it exists before anything uses it: the
# first machine makes one and puts it without --overwrite, and every machine — the first too —
# then reads what SSM holds. It is never read here: the document says where it is
# (config.tf, encryption_key_at) and the control plane reads it with its own credentials at every
# start, so the key is on no disk of this installation and in no file this script wrote.
# A machine that dies here has lost nothing; two first machines racing both end on the one that
# was stored.
if ! aws ssm get-parameter --name '${key_parameter}' --query Parameter.Name --output text >/dev/null 2>&1; then
  file=$(mktemp); chmod 600 "$file"
  head -c 32 /dev/urandom | base64 -w0 >"$file"
  aws ssm put-parameter --name '${key_parameter}' --type SecureString --value "file://$file" \
    --description 'The encryption key of ${name}: with the catalog, the installation' >/dev/null ||
    echo "another machine stored the key first: that one is the installation's"
  rm -f "$file"
  aws ssm get-parameter --name '${key_parameter}' --query Parameter.Name --output text >/dev/null ||
    { echo "${key_parameter} holds no encryption key"; exit 1; }
fi
# A file anyone may read in a directory anyone may enter: spin-install puts the database's CA
# here, and the control plane reads it as its own user - a directory only root may enter is a
# control plane that cannot open the CA it verifies its catalog by.
install -d -m 0755 /etc/spin-stack

# --- the release -----------------------------------------------------------------------------
${fetch_release}
cd "$(mktemp -d)"
release '${spin_version}' spin-controlplane-linux-amd64.tar.gz
tar -xzf spin-controlplane-linux-amd64.tar.gz -C /

# --- the catalog: RDS, checked against its own CA, signed in to with this machine's role -------
curl -fsSL -o /etc/spin-stack/database-ca.pem "https://truststore.pki.rds.amazonaws.com/$region/$region-bundle.pem"
# The master's password is read once, into the environment of the one psql that needs it - an
# argument would be in ps - and makes the role the control plane signs in as.
PGPASSWORD=$(aws secretsmanager get-secret-value --secret-id '${database_admin}' \
    --query SecretString --output text | python3 -c 'import json, sys; print(json.load(sys.stdin)["password"])') \
  psql "host=${database_host} dbname=spin user=spin_admin sslmode=verify-full sslrootcert=/etc/spin-stack/database-ca.pem" \
  -v ON_ERROR_STOP=1 -q -f /etc/spin-stack/database-bootstrap.sql

# The name, then the term. Pointed here first, so whoever the old machine drops when it is
# superseded redials this one; then spin-install starts the control plane, which takes the term.
previous=$(resolve '${cp_host}')
point '${cp_host}'
# One location, and where this machine put the database's bundle: the catalog, the key, the
# names the certificate covers and where telemetry goes are in the document (config.tf), which
# the control plane reads itself at every start. Nothing of the installation is written onto
# this disk, so a replaced machine starts on the same values without this script assembling
# them again.
spin-install control-plane --config 'ssm://${config_parameter}' \
  --database-ca /etc/spin-stack/database-ca.pem \
  --s3-bucket '${bucket}' --s3-region "$region" --s3-role-arn '${role_arn}'

# --- the installation's config: the operator's, and how the runners are sized ----------------
# By name, and as the control plane's own user: the command runs as that user (spin-install
# writes the wrapper that way), so a redirection hands it a descriptor of root's that it cannot
# open. The file stays 0600 - it is the operator's, and may hold what the installation is
# registered with - and belongs to the one account that reads it.
# Whoever owns the state directory systemd made for the service is that user, named once by
# spin-install and not again here.
chown --reference=/var/lib/spin-stack /etc/spin-stack/installation.yaml
spin-controlplane config apply /etc/spin-stack/installation.yaml
# What this file decides that a process reads at its start — where the installation pushes what
# it records — reaches this control plane when it starts again, so it is started again here,
# while nothing depends on it yet, rather than at whatever restart happens next.
systemctl restart spin-controlplane.service

# The domain this installation answers on, which it is otherwise asked for in the setup pages -
# and this installation was given it before any of it existed. Until it is set the control plane
# takes every browser origin but localhost for another site, so the dashboard loads and a
# workspace's terminal is refused. Saying the domain it is already on changes nothing, which is
# what a replaced machine does.
spin-controlplane base-domain '${domain}'

# --- publish ---------------------------------------------------------------------------------
aws ssm put-parameter --name '${ca_parameter}' --type String --overwrite \
  --value file:///var/lib/spin-stack/certs/ca.crt >/dev/null

# The first administrator, where the operator reads it without a shell on a machine. The
# password is the one-time one the catalog sealed and stops existing the moment that
# administrator chooses their own, so this writes what there is and is quiet when there is
# nothing: a replacement of this machine finds the installation already set up. The value goes in
# a file, never an argument, and the parameter is the control plane's alone to read (boundary.tf).
if password=$(spin-controlplane bootstrap-password 2>/dev/null); then
  file=$(mktemp); chmod 600 "$file"
  printf '%s' "$password" >"$file"
  unset password
  aws ssm put-parameter --name '${bootstrap_password_parameter}' --type SecureString --overwrite \
    --value "file://$file" \
    --description 'The one-time password of the first administrator of ${name}, until they choose their own' >/dev/null
  rm -f "$file"
  aws ssm put-parameter --name '${bootstrap_user_parameter}' --type String --overwrite \
    --value "$(spin-controlplane bootstrap-password --user)" \
    --description 'Whom that password is for' >/dev/null
fi

systemctl daemon-reload
%{ if collector != "" ~}
# What Alloy trusts the control plane by, when it reads what to sample and drop.
install -m 0644 /var/lib/spin-stack/certs/ca.crt /etc/alloy/spin-ca.crt
systemctl enable --now spin-alloy-token.timer alloy.service
%{ endif ~}
systemctl enable spin-pool-token.timer
systemctl start spin-pool-token.service spin-pool-token.timer

# Leading, and published: the group may retire the machine this one replaced. From here a
# control plane that stays down is a machine to replace.
in_service
serving=yes
systemctl enable --now spin-controlplane-watchdog.timer
echo "spin control plane is installed and in service; runners join at https://${cp_host}:8080"
